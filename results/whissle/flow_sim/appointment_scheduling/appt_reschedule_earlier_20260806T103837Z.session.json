        "id": "confirm_booked",
        "goal": "The appointment has just been booked. Read back the final date, time, and provider clearly, exactly as the booking tool returned them, so the caller knows it is confirmed. Keep it to one clear sentence. Do not offer to book anything else and never invent a time the tool did not return.",
        "type": "conversation",
        "label": "Confirm the booking",
        "allowed_tools": [],
        "entry_actions": [
          {
            "key": "booking_confirmed",
            "kind": "set_variable",
            "value": true
          }
        ]
      },
      {
        "id": "send_confirmation",
        "tool": "send_sms",
        "type": "tool",
        "label": "Text confirmation"
      },
      {
        "id": "reschedule_or_cancel",
        "goal": "The caller wants to change an existing appointment. To reschedule, ask the new date/time and call reschedule_appointment. To cancel, gently offer to reschedule first, then call cancel_appointment if they still want to cancel. These tools locate the appointment by phone number — do not look up records first. If none is found, ask for the phone number the booking was made under and try again; if still not found, offer to transfer to a human.",
        "type": "conversation",
        "label": "Reschedule / cancel",
        "allowed_tools": [
          "reschedule_appointment",
          "cancel_appointment",
          "transfer_call"
        ]
      },
      {
        "id": "confirm_change",
        "goal": "Read back exactly what changed so the caller knows it is done: for a reschedule, state the new date and time clearly; for a cancellation, confirm the appointment is cancelled. Keep it to one clear sentence, then let them know they're all set.",
        "type": "conversation",
        "label": "Confirm the change",
        "allowed_tools": []
      },
      {
        "id": "close",
        "say": "You're all set. Thanks for calling, and take care. Goodbye!",
        "type": "say",
        "label": "Close"
      },
      {
        "id": "done",
        "type": "end"
      }
    ],
    "enabled": true,
    "version": 1,
    "settings": {
      "on_guard_trip": "fallback",
      "fallback_state": "close",
      "max_visits_per_state": 4,
      "max_transitions_per_call": 40
    },
    "variables": [
      {
        "key": "booking_confirmed",
        "type": "boolean",
        "initial": false
      }
    ],
    "start_state": "greet",
    "transitions": [
      {
        "id": "t_new",
        "to": "capture_need",
        "from": "greet",
        "kind": "llm_condition",
        "priority": 20,
        "condition": "the caller wants to book a new appointment"
      },
      {
        "id": "t_change",
        "to": "reschedule_or_cancel",
        "from": "greet",
        "kind": "llm_condition",
        "priority": 15,
        "condition": "the caller wants to reschedule or cancel an existing appointment"
      },
      {
        "id": "t_captured",
        "to": "check_slot",
        "from": "capture_need",
        "kind": "llm_condition",
        "priority": 10,
        "condition": "the caller has given both their full name and a callback phone number"
      },
      {
        "id": "t_slot_ok",
        "to": "book",
        "from": "check_slot",
        "kind": "llm_condition",
        "priority": 20,
        "condition": "check_availability confirmed the requested slot, or an alternative the caller chose, is open"
      },
      {
        "id": "t_slot_transfer",
        "to": "close",
        "from": "check_slot",
        "kind": "llm_condition",
