  "flow_spec": {
    "states": [
      {
        "id": "greet",
        "say": "Thanks for calling. I can book, move or cancel an appointment, or tell you our opening hours — what can I do for you?",
        "type": "say"
      },
      {
        "id": "triage",
        "goal": "Lead the caller with a one-line menu and find out what they need: book a new appointment, reschedule or cancel an existing one, or hear the opening hours. If they describe a dental problem or pain, treat it as a booking request. Use get_hours to answer any hours question. For a genuine dental emergency offer to transfer to a person, and if the request is after hours or beyond scheduling take a message.",
        "type": "conversation",
        "label": "Understand the request",
        "allowed_tools": [
          "get_hours",
          "take_message",
          "transfer_call"
        ]
      },
      {
        "id": "book_collect",
        "goal": "Classify the appointment type (exam & cleaning, consultation, filling/crown/follow-up, or emergency) and confirm it back. Ask whether the caller is a new or existing patient, collect their full name and date of birth once, and for an existing patient scheduling a new visit use lookup_record to verify them. Collect a callback phone number and save it with save_contact_field under the key callback_number. Ask for each detail only once — anything the caller already mentioned earlier in the call (even in passing) counts as collected; never re-ask it.",
        "type": "conversation",
        "label": "Classify visit and collect details",
        "allowed_tools": [
          "lookup_record",
          "collect_digits",
          "save_contact_field",
          "save_email"
        ],
        "turn_taking_override": {
          "barge_in": "off",
          "vad_stop_secs": 1.6,
          "user_speech_timeout": 2.5
        }
      },
      {
        "id": "book_schedule",
        "goal": "Ask for the caller's preferred date and time, then use check_availability with an ISO date to confirm the slot is open. If it is taken, offer the alternatives the tool returns and let the caller choose one. Only offer times that fall inside the practice hours.",
        "type": "conversation",
        "label": "Find an open slot",
        "allowed_tools": [
          "check_availability"
        ]
      },
      {
        "id": "book_confirm",
        "tool": "book_appointment",
        "type": "tool",
        "label": "Book the appointment"
      },
      {
        "id": "send_confirmation",
        "tool": "send_sms",
        "type": "tool",
        "label": "Text the confirmation"
      },
      {
        "id": "reschedule",
        "goal": "Ask what new date and time the caller would like and confirm it back before proceeding. The change is looked up by phone number — do not look up patient records first. If a previous attempt found no appointment, ask which phone number the booking was made under.",
        "type": "conversation",
        "label": "Collect the new time",
        "allowed_tools": []
      },
      {
        "id": "reschedule_do",
        "tool": "reschedule_appointment",
        "type": "tool",
        "label": "Move the appointment"
      },
      {
        "id": "reschedule_confirm",
        "goal": "The appointment has just been moved. Read the new date and time back to the caller exactly as the tool returned them, in one clear sentence, so they know the change is done. Never invent a time the tool did not return.",
        "type": "conversation",
        "label": "Confirm the new time",
        "allowed_tools": []
      },
      {
        "id": "cancel",
        "goal": "Before cancelling, warmly offer to reschedule instead. If the caller still wants to cancel, confirm you will cancel their appointment. The cancellation is located by phone number — if a previous attempt found no appointment, ask which phone number the booking was made under.",
        "type": "conversation",
        "label": "Retention first, then confirm cancel",
        "allowed_tools": []
      },
      {
        "id": "cancel_do",
        "tool": "cancel_appointment",
        "type": "tool",
        "label": "Cancel the appointment"
      },
      {
        "id": "cancel_confirm",
        "goal": "The appointment has just been cancelled. Confirm to the caller in one clear sentence that it is cancelled. Do not claim anything the tool did not confirm.",
        "type": "conversation",
        "label": "Confirm the cancellation",
        "allowed_tools": []
      },
